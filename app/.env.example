# Copy this file to ".env" (same folder) and fill in your keys.
# setup.bat / setup.sh does the copy for you. Never commit the real .env.

# REQUIRED — Companies House API key (Stage 1 fetch).
# Free, takes a minute: https://developer.company-information.service.gov.uk/
CH_API_KEY=your_ch_api_key_here

# OPTIONAL — Apollo API key. Only powers the live "Fetch credits" button and the
# credit chopper's auto-fetch; enrichment itself is done by uploading to Apollo's
# website. Leave as-is if you don't have one.
APOLLO_API_KEY=

# OPTIONAL — Flask session secret. Any random string; a default is used if blank.
FLASK_SECRET_KEY=change_me_to_a_random_string
